{% extends "layout/main.twig" %}
{% block title %}{{ getFunction('getCurrentChannel').name|default('Vaultfy') }}{% endblock %}

{% block main_content %}
<div class="home vf-up" id="vf-up-home">
    <div class="vf-up-inner">
        {# Choose one active platform-managed banner, as in the reference. #}
        {% set hero = null %}
        {% set current_timestamp = "now"|date("U") %}
        {% for content in homeContent %}
            {% if hero is null and (content['slug'] == 'fixed_banner' or content['slug'] == 'wide_banner')
                and content['settings']['image'] %}
                {% set begins = content['settings']['start_date']|default('') %}
                {% set ends = content['settings']['end_date']|default('') %}
                {% if (not begins or begins|date("U") <= current_timestamp)
                   and (not ends or ends|date("U") >= current_timestamp) %}
                    {% set hero = content %}
                {% endif %}
            {% endif %}
        {% endfor %}
        {% if hero %}
            <section class="vf-up-hero" aria-label="{{ lang == 'ar' ? 'عروض المتجر' : 'Store promotions' }}">
                {% include 'custom/bold-banner.twig' with {'content': hero} %}
            </section>
        {% endif %}

        <section class="vf-up-section" aria-label="{{ lang == 'ar' ? 'أقسام المتجر' : 'Store categories' }}">
            <div class="vf-up-category-grid" id="vf-up-category-grid" data-storage-base="{{ storage_url }}">
                {# Artist-supplied media fallback, indexed by category link/name.
                   Live /category response supplies the authoritative categories
                   and their links. Never use competitor artwork or mocked prices. #}
                {% for content in homeContent %}
                    {% if content['slug'] == 'list_of_items' %}
                        {% for item in content['settings']['items'] %}
                            {% if item['link'] and item['name'] %}
                                <a class="vf-up-category-card" href="{{ item['link'] }}">
                                    <span class="vf-up-category-poster">
                                        <span class="vf-up-category-art{{ not item['image'] ? ' vf-up-no-image' : '' }}">
                                            {% if item['image'] %}
                                                <img src="{{ item['image'] }}" alt="{{ item['name'] }}" loading="lazy" decoding="async">
                                            {% endif %}
                                        </span>
                                        <span class="vf-up-category-cta">{{ lang == 'ar' ? 'اضغط هنا' : 'Click here' }}</span>
                                    </span>
                                    <span class="vf-up-category-name">{{ item['name'] }}</span>
                                </a>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </div>
            <p class="vf-up-empty" id="vf-up-category-status" hidden></p>
        </section>

        {# Preserve merchant-authored optional content when enabled in admin. #}
        {% for content in homeContent %}
            {% if content['slug'] == 'store_features' %}
                {% include 'custom/store-features.twig' with {'content': content} %}
            {% elseif content['slug'] == 'customer_options' %}
                {% include 'custom/customer-options.twig' with {'content': content} %}
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block footer_scripts %}
    <script>
      $(function () {
        $('.vf-up .owl-carousel').each(function () {
          if ($.fn.owlCarousel) $(this).owlCarousel({
            loop: false, autoplay: false, nav: false, margin: 16,
            rtl: {{ lang == 'ar' ? 'true' : 'false' }},
            responsive: { 0: { items: 1 }, 600: { items: 2 }, 1024: { items: 3 } }
          });
        });
      });
    </script>
{% endblock %}
