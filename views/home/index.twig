{% extends "layout/main.twig" %}
{% block title %}Vaultfy{% endblock %}

{% block main_content %}
<div class="home vf-up" id="vf-up-home">
    {# UP Store reference: a wide hero followed by image-first, three-across categories.
       Images and links come exclusively from merchant-managed Twsaa content. #}
    <div class="vf-up-inner">
        {% for content in homeContent %}
            {% if (content['slug'] == 'fixed_banner' or content['slug'] == 'wide_banner') and content['settings']['image'] %}
                <section class="vf-up-hero">
                    {% include 'custom/bold-banner.twig' with {'content': content} %}
                </section>
            {% endif %}
        {% endfor %}
        <section class="vf-up-section" aria-labelledby="vf-up-categories-heading">
            <div class="vf-up-section-heading">
                <h2 id="vf-up-categories-heading">{{ lang == 'ar' ? 'تصفح الأقسام' : 'Browse categories' }}</h2>
                <p>{{ lang == 'ar' ? 'اختر منصتك المفضلة' : 'Find your next subscription' }}</p>
            </div>
            <div class="vf-up-category-grid" id="vf-up-category-grid">
                {# Server-rendered image-rich fallback while native categories load.
                   Images correspond to admin-configured list_of_items blocks only. #}
                {% for content in homeContent %}
                    {% if content['slug'] == 'list_of_items' %}
                        {% for item in content['settings']['items'] %}
                            {% if item['link'] and item['name'] %}
                                <a class="vf-up-category-card" href="{{ item['link'] }}" data-up-category-link="{{ item['link'] }}">
                                    <span class="vf-up-category-image">
                                        {% if item['image'] %}
                                            <img src="{{ item['image'] }}" loading="lazy" alt="{{ item['name'] }}">
                                        {% else %}
                                            <span class="vf-up-category-placeholder" aria-hidden="true">{{ item['name']|slice(0, 1) }}</span>
                                        {% endif %}
                                    </span>
                                    <span class="vf-up-category-name">{{ item['name'] }}</span>
                                </a>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </div>
            <p id="vf-up-category-status" class="vf-up-empty" hidden></p>
        </section>
        {% for content in homeContent %}
            {% if content['slug'] == 'store_features' %}
                {% include 'custom/store-features.twig' with {'content': content} %}
            {% endif %}
            {% if content['slug'] == 'customer_options' %}
                {% include 'custom/customer-options.twig' with {'content': content} %}
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block footer_scripts %}
    <script src="{{ asset_url ~ 'js/vaultfy-up.js' }}" defer></script>
    <script>
        $(function () {
            $('.vf-up .owl-carousel').each(function () {
                if ($.fn.owlCarousel) {
                    $(this).owlCarousel({
                        loop: false, margin: 16, autoplay: false, nav: false,
                        rtl: {{ lang == 'ar' ? 'true' : 'false' }},
                        responsive: { 0: { items: 1 }, 600: { items: 2 }, 1024: { items: 3 } }
                    });
                }
            });
        });
    </script>
{% endblock %}
