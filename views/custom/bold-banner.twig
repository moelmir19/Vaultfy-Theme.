{# Merchant-controlled banner. Never replace its image/link with competitor assets. #}
{% if content['settings']['image'] %}
    {% set start_date = content['settings']['start_date']|default('') %}
    {% set end_date = content['settings']['end_date']|default('') %}
    {% set current_time = "now"|date("U") %}
    {% set in_window = true %}

    {% if start_date and current_time < start_date|date("U") %}
        {% set in_window = false %}
    {% endif %}
    {% if end_date and current_time > end_date|date("U") %}
        {% set in_window = false %}
    {% endif %}

    {% if in_window %}
        {% if content['settings']['link'] %}
            <a id="block{{ content['block_id'] }}" href="{{ content['settings']['link'] }}">
        {% endif %}
        <img class="w-100" src="{{ content['settings']['image'] }}" loading="eager"
             alt="{{ content['settings']['alt']|default('Vaultfy') }}">
        {% if content['settings']['link'] %}
            </a>
        {% endif %}
    {% endif %}
{% endif %}
