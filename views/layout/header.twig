{# Vaultfy header: UP Store spatial layout, Twsaa-owned account/cart/search. #}
{% set channel = getFunction('getCurrentChannel') %}
<header class="vf-site-header">
  <div class="header-container">
    <div class="header-row-one">
      <div class="vf-header-leading">
        <button id="vf-menu-toggle" type="button" class="vf-header-action vf-menu-toggle"
                aria-label="{{ lang == 'ar' ? 'فتح القائمة' : 'Open menu' }}"
                aria-expanded="false" aria-controls="vf-primary-menu">
          <i class="icon-menu" aria-hidden="true"></i>
        </button>
        <button id="vf-search-toggle" type="button" class="vf-header-action vf-search-toggle"
                aria-label="{{ lang == 'ar' ? 'بحث' : 'Search' }}"
                aria-expanded="false" aria-controls="vf-search-panel">
          <i class="icon-search" aria-hidden="true"></i>
        </button>
        <div class="vf-header-locale">
          <div class="dropdown-toggle vf-header-action" role="button" tabindex="0" aria-label="Language">
            <i class="icon-world" aria-hidden="true"></i>
          </div>
          <div class="dropdown-list bottom-left dropdown-links" style="display:none;">
            <ul>
              {% for locale in getFunction('getAllLocales') %}
                <li><a href="?locale={{ locale.code }}">{{ locale.name }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <div class="vf-header-currency">
          <div class="dropdown-toggle vf-header-action" role="button" tabindex="0" aria-label="Currency">
            <i class="icon-flag" aria-hidden="true"></i>
          </div>
          <div class="dropdown-list bottom-left dropdown-links" style="display:none;">
            <ul>
              {% for currency in getFunction('getActiveChannelCurrency') %}
                <li><a href="?currency={{ currency.code }}">{{ currency.code }} {{ currency.symbol }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>

      <div class="vf-header-brand store-logo top-links-2">
        <a href="/" aria-label="Vaultfy">
          <img src="{{ asset_url ~ 'images/vaultfy-logo.webp' }}"
               class="logo vf-logo" width="190" height="143" alt="Vaultfy">
        </a>
      </div>

      <div class="vf-header-trailing">
        <div class="vf-account-wrap">
          <button class="vf-header-action top-links-icon top-links-account {{ authUser ? 'dropdown-toggle' : '' }}"
                  type="button" aria-label="{{ lang == 'ar' ? 'حسابي' : 'Account' }}"
                  {% if not authUser %}data-toggle="modal" data-target="#customerLoginModal"{% endif %}>
            <i class="icon-user" aria-hidden="true"></i>
          </button>
          {% if authUser %}
            <ul class="dropdown-list bottom-right customer-dropdown dropdown-links" style="display:none;">
              <li class="no-link">{{ authUser.first_name }}</li>
              <li><a href="/customer/account/notifications"><i class="icon-bell"></i> {{ ('shop::app.header.notifications'|trans) }}</a></li>
              <li><a href="/customer/account/profile"><i class="icon-user"></i> {{ ('shop::app.header.profile'|trans) }}</a></li>
              <li><a href="/customer/account/wishlist"><i class="icon-heart"></i> {{ ('shop::app.header.wishlist'|trans) }}</a></li>
              <li><a href="/customer/account/orders"><i class="icon-packed-box"></i> {{ ('shop::app.header.orders'|trans) }}</a></li>
              <li><a href="/customer/account/logout"><i class="icon-send-out"></i> {{ ('shop::app.header.logout'|trans) }}</a></li>
            </ul>
          {% endif %}
        </div>
        <a class="vf-header-action vf-header-cart cart-dropdown-container top-links-cart"
           href="/checkout/cart" aria-label="{{ lang == 'ar' ? 'السلة' : 'Cart' }}">
          <i class="icon-cart" aria-hidden="true"></i>
          <span class="count-wrapper cart-count count">{{ getFunction('cartItemsCount') }}</span>
        </a>
        <a class="vf-header-wallet" href="/customer/account/wallet" aria-label="Wallet">
          <span class="wallet-wrapper">{{ getFunction('customerWallet')|default('0')|raw }}</span>
        </a>
      </div>
    </div>

    <div id="vf-primary-menu" class="primary-menu vf-primary-menu">
      {% include 'layout/navbar.twig' %}
    </div>
    <div id="vf-search-panel" class="vf-search-panel">
      <div class="ui search">
        <input type="search" class="prompt search-box" autocomplete="off"
               placeholder="{{ lang == 'ar' ? 'ابحث عن منتج' : 'Search products' }}"
               aria-label="{{ lang == 'ar' ? 'البحث عن منتج' : 'Search products' }}">
        <i class="notch-loader gray search-loader" style="display:none;"></i>
        <div class="results"></div>
      </div>
    </div>
  </div>
</header>